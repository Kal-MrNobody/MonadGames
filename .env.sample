# Monad testnet
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_FACTORY_ADDRESS=0xd639772dCF6bcc924D075dF0E9c66e4ed2De99d4
# Server-side key of the rewarder (deployer 0xC07d95248860eD400A3964154e9169903Cbfa8ce) used by /api/reward
REWARDER_PRIVATE_KEY=
# AI game generation: OpenAI is used when set; Together AI (Qwen) is the fallback; with neither, a built-in heuristic customizer runs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional fallback provider
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
